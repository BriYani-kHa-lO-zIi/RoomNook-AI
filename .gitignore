# ===========================================
#  RoomNook AI — .gitignore
# ===========================================

# ── Python ──────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.pyo

# Virtual environment
venv/
.venv/
env/
ENV/

# ── Environment / Secrets ───────────────────
.env
.env.local
.env.production
# (keep .env.example – it is safe to commit)

# ── Databases ───────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Node / Frontend ─────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
build/
.next/

# ── IDE / OS ────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── Logs & Coverage ─────────────────────────
*.log
coverage/
.nyc_output/
htmlcov/
.coverage
.pytest_cache/

# ── Misc ────────────────────────────────────
*.bak
*.tmp
.cache/
